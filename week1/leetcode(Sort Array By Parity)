class Solution {
    public int[] sortArrayByParity(int[] nums) {

        int[] result = new int[nums.length];
        int index = 0;

        // First add even numbers
        for (int num : nums) {
            if (num % 2 == 0) {
                result[index++] = num;
            }
        }

        // Then add odd numbers
        for (int num : nums) {
            if (num % 2 != 0) {
                result[index++] = num;
            }
        }

        return result;
    }
}


